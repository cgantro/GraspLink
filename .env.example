# GraspLink simulator local configuration.
# Copy this file to .env and replace the serial device for this PC. Values are
# deliberately text rather than source constants: the assigned COM port can
# change when the board is moved to another USB connector.
# v1 uses the DevKitC's USB-to-UART bridge; Wi-Fi/UDP is a later extension.
SIM_SERIAL_PORT=COM3
SIM_SERIAL_BAUD_RATE=115200

# All positions are metres in the simulator world frame.  The embedded ADC
# mapper clamps its selected coordinate to these same limits.
SIM_WORKSPACE_MIN_X=-0.90
SIM_WORKSPACE_MAX_X=0.90
SIM_WORKSPACE_MIN_Y=0.10
SIM_WORKSPACE_MAX_Y=1.20
SIM_WORKSPACE_MIN_Z=-0.90
SIM_WORKSPACE_MAX_Z=0.90

# Fixed TCP orientation used to turn an XYZ controller command into a full
# 6DoF IK target. Quaternion order is w, x, y, z.
SIM_TCP_QW=1.0
SIM_TCP_QX=0.0
SIM_TCP_QY=0.0
SIM_TCP_QZ=0.0

SIM_GRASP_POSITION_TOLERANCE_M=0.020
SIM_GRASP_ORIENTATION_TOLERANCE_DEG=5.0
SIM_IK_MAX_ITERATIONS=100
SIM_IK_DAMPING=0.080
