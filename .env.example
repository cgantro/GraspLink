# GraspLink simulation configuration.
# Copy this file to .env when local overrides are needed.

# Simulation workspace bounds [m].
SIM_WORKSPACE_MIN_X=-0.90
SIM_WORKSPACE_MAX_X=0.90
SIM_WORKSPACE_MIN_Y=0.10
SIM_WORKSPACE_MAX_Y=1.20
SIM_WORKSPACE_MIN_Z=-0.90
SIM_WORKSPACE_MAX_Z=0.90

# Initial target orientation. Quaternion order is w, x, y, z.
SIM_TARGET_QW=1.0
SIM_TARGET_QX=0.0
SIM_TARGET_QY=0.0
SIM_TARGET_QZ=0.0

# Grasp / IK parameters.
SIM_GRASP_POSITION_TOLERANCE_M=0.020
SIM_GRASP_ORIENTATION_TOLERANCE_DEG=5.0
SIM_IK_MAX_ITERATIONS=100
SIM_IK_DAMPING=0.080
